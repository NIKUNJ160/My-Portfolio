{
  "name": "nikunj-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run typecheck",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute portfolio-db --local --file=schema.sql",
    "db:deploy": "wrangler d1 execute portfolio-db --remote --file=schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.120.0"
  }
}
